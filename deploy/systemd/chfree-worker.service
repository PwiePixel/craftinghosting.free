[Unit]
Description=CraftingHosting.free Worker
After=network.target mariadb.service

[Service]
Type=simple
User=chfree
WorkingDirectory=/opt/craftinghosting-free/apps/api
EnvironmentFile=/opt/craftinghosting-free/.env
Environment=NODE_ENV=production
Environment=RUN_JOBS_IN_API=false
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
