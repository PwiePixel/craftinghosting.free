# =============================================================================
#  CraftingHosting.free – Umgebungsvariablen
#  Kopieren nach .env und anpassen. Die .env NIEMALS committen.
#  Secrets (DB-Schlüssel, Pterodactyl-Keys, SMTP) werden nur von API/Worker gelesen –
#  die Website bekommt ausschließlich NEXT_PUBLIC_*-Werte.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------- Docker (Produktion) ---
# Nur für docker compose: HTTPS-Domain
SITE_DOMAIN=craftinghosting.free

# ----------------------------------------------------------------- Website ---
# Öffentliche URL der Website (Links in E-Mails, SEO, Origin-Prüfung)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Interne URL der API, die der Next.js-Server für SSR-Abrufe nutzt
API_INTERNAL_URL=http://localhost:4000
# Optionale Überschreibungen der Links zur Hauptmarke
NEXT_PUBLIC_PARENT_URL=https://crafting.host
NEXT_PUBLIC_PARENT_PRICING_URL=https://crafting.host/pricing
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/x6mUFN8wjA
# Öffentliche Panel-URL (nur für Links, kein Secret)
NEXT_PUBLIC_PANEL_URL=https://panel.craftinghosting.free

# ------------------------------------------------------------------- Admin ---
# E-Mail-Adressen mit Zugriff auf den Admin-Bereich, kommagetrennt.
# Anmeldung wie gewohnt per E-Mail-Link (/login), danach den geheimen Admin-Pfad aufrufen.
# Alternativ: docker compose run --rm api node dist/cli.js make-admin du@example.com
ADMIN_EMAILS=
# Der Admin-Bereich liegt unter /admin – erreichbar NUR für angemeldete Admins (Rolle im Backend bzw. ADMIN_EMAILS).
# Alle anderen, auch nicht angemeldete Besucher, sehen dort eine normale 404-Seite. Nirgends verlinkt, noindex.
# Optional ein zusätzlicher eigener Pfad (z. B. /team-7f3k9) – /admin funktioniert für Admins immer.
ADMIN_PATH=/admin

# --------------------------------------------------------------------- API ---
API_HOST=0.0.0.0
API_PORT=4000
TRUST_PROXY=true
# Weitere erlaubte Origins (kommagetrennt), z. B. https://www.craftinghosting.free
ALLOWED_ORIGINS=
# Für den Website-Check auf der Statusseite
WEB_INTERNAL_URL=http://localhost:3000

# Datenbank: verschlüsselte SQLite-Datei (kein Datenbank-Server nötig). Relative Pfade gelten ab dem Ordner dieser .env.
DATABASE_PATH=./data/chfree.db
# Schlüssel der Datenbank-Verschlüsselung – erzeugen mit:  openssl rand -hex 32
# In Produktion Pflicht (mind. 32 Zeichen). Ohne diesen Schlüssel lässt sich die Datenbank NICHT mehr öffnen –
# unbedingt getrennt von der Datenbank-Datei sichern. IP-Adressen/User-Agents werden damit zusätzlich feldweise verschlüsselt.
DATABASE_ENCRYPTION_KEY=

# Sessions
SESSION_COOKIE_NAME=chf_session
# Anmeldung ist bewusst kurzlebig – man meldet sich regelmäßig neu per E-Mail-Link an:
# Abmeldung nach X Minuten ohne Aktivität, spätestens nach Y Stunden. Das Cookie endet mit dem Schließen des Browsers.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# true = Anmeldung bleibt auch nach dem Schließen des Browsers bis zum Ablauf erhalten
SESSION_PERSISTENT=false
# auto = secure, wenn APP_URL mit https:// beginnt
COOKIE_SECURE=auto
COOKIE_DOMAIN=

# ------------------------------------------------------------- Pterodactyl ---
# mock = lokale Simulation ohne Panel · live = echtes Panel
PTERODACTYL_MODE=mock
PTERODACTYL_URL=https://panel.craftinghosting.free
PTERODACTYL_PUBLIC_URL=https://panel.craftinghosting.free
# Application-API-Key (ptla_…) – Rechte: Users R/W, Servers R/W, Nests R, Nodes R, Locations R, Allocations R
PTERODACTYL_APP_KEY=
# Client-API-Key (ptlc_…) eines Admin-Accounts – für Power-Aktionen, Ressourcen, Zeitpläne
PTERODACTYL_CLIENT_KEY=
# Nodes und Eggs werden automatisch aus dem Panel eingelesen und im Admin-Bereich zugewiesen
# (Admin → Pterodactyl: Nodes für Minecraft, eigene Node für Discord-Bots, Eggs für Python/Node.js).
# Optional: Location-IDs als Rückfall für Minecraft, wenn keine Node ausgewählt ist (leer = alle Locations)
PTERODACTYL_LOCATION_IDS=
# Early Access: getrennte Locations je Hardware (leer = PTERODACTYL_LOCATION_IDS).
# Die ersten Wartelisten-Plätze (Admin → Einstellungen → „Plätze auf AMD EPYC“) landen auf EPYC, alle weiteren auf Xeon.
PTERODACTYL_LOCATION_IDS_EPYC=
PTERODACTYL_LOCATION_IDS_XEON=
PTERODACTYL_TIMEOUT_MS=10000
# Anfrage-Limit des Panels je Minute (wie APP_API_CLIENT_RATELIMIT / APP_API_APPLICATION_RATELIMIT in der .env des
# Panels). Nur ein Rückfall – meldet das Panel sein Limit in den Antworten, gilt dieses. Siehe README „Anfrage-Limit“.
# PTERODACTYL_CLIENT_RATE_LIMIT=720
# PTERODACTYL_APP_RATE_LIMIT=240
# Partner-API: So viele Panel-Aufrufe je Minute dürfen alle Partner zusammen auslösen (ein einzelner höchstens 80 %).
# Unter dem Limit des Panels halten (Standard dort: 720 je Minute für den Client-Key), damit die Stopp-Befehle
# unserer Jobs immer durchkommen.
# PARTNER_PANEL_CALLS_PER_MINUTE=300
# Partner-API: Verzeichnis der Server-Software für Typen ohne eigenes Egg (Fabric, Forge, NeoForge, Quilt …)
# MCJARS_API_URL=https://mcjars.app/api/v2
# Egg-Zuordnung pro Servertyp (nestId:eggId) – "off" deaktiviert einen Typ
# PTERODACTYL_EGG_PAPER=1:3
# PTERODACTYL_EGG_VANILLA=1:5
# PTERODACTYL_EGG_FORGE=1:2
# PTERODACTYL_EGG_PURPUR=1:16
# PTERODACTYL_EGG_FABRIC=1:17

# ------------------------------------------------------------------- Beta ---
# Beta-Instanz: zweite Installation mit derselben Datenbank, nur für Nutzer mit Beta-Zugang (Admin → Nutzer).
# Einrichten mit:  sudo bash install.sh --beta   – der Installer setzt diese Werte selbst.
# Auf der HAUPTSEITE: Adresse der Beta-Instanz (zeigt freigeschalteten Nutzern den Einstieg unter „Meine Server“)
BETA_URL=
# Nur in der .env der BETA-Instanz:
# BETA_MODE=true
# MAIN_URL=https://craftinghosting.free

# ---------------------------------------------------------------- Domains ---
# Weitere Domains, Weiterleitungen und der Cloudflare Tunnel werden im Admin-Bereich verwaltet (Admin → Domains).
# Öffentliche IP-Adressen dieses Servers (kommagetrennt) – der Admin-Bereich zeigt sie als Ziel für DNS-Einträge.
# Der Installer trägt sie automatisch ein; leer = Adressen der Hauptdomain.
SERVER_PUBLIC_IPS=
# Pfad zum Tunnel-Programm, falls es nicht im PATH liegt (Standard: cloudflared)
# CLOUDFLARED_BIN=/usr/bin/cloudflared

# ------------------------------------------------------------------- Mail ---
# SMTP_HOST leer = E-Mails werden nur ins Log geschrieben (Entwicklung)
# Üblich: Port 587 (STARTTLS) oder 465 (SSL). SMTP_SECURE=auto wählt passend zum Port.
# Testen:  docker compose run --rm api node dist/cli.js mail-test du@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=auto
SMTP_USER=
SMTP_PASS=
# Absender – leer = SMTP_USER. Muss zum Postfach gehören (mailcow lehnt fremde Absender ab).
MAIL_FROM=

# ------------------------------------------------------------------- Jobs ---
# true = Jobs laufen im API-Prozess (Entwicklung). Produktion: eigener Worker.
RUN_JOBS_IN_API=true

# ----------------------------------------------------------------- Status ---
# internal = eigene Checks · static = immer "operational"
STATUS_PROVIDER=internal
